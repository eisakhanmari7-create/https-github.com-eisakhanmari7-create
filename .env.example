# GEMINI_API_KEY: Required for Gemini Vision & AI caption generation
GEMINI_API_KEY="your_gemini_api_key_here"

# BASE_URL / APP_URL: Public URL of your deployed application (e.g. https://gnzee-social-hub.onrender.com)
BASE_URL="https://gnzee-social-hub.onrender.com"
APP_URL="https://gnzee-social-hub.onrender.com"

# PORT: Server listening port (Render automatically sets this)
PORT=3000

# DATA_DIR: Directory for persistent storage on persistent disks/volumes
# Defaults to ./data locally; on Render mount a disk to /data and set DATA_DIR=/data
DATA_DIR="/data"

# DRIVE_ROOT_ID: Root Google Drive folder ID (Grok tools)
DRIVE_ROOT_ID="1nM8BeH7Nnb9MMRIoA23qEmTrLbi19Gsg"

# MAKE_WEBHOOK_URL: Webhook URL from Make.com scenario
MAKE_WEBHOOK_URL=""

# GOOGLE_CLIENT_ID & GOOGLE_CLIENT_SECRET (Optional for server-side token auto-renewal)
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# GOOGLE_REFRESH_TOKEN: Permanent OAuth Refresh Token for server background jobs
GOOGLE_REFRESH_TOKEN=""
